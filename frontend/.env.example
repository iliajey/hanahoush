# Frontend environment — VITE_ variables are statically inlined by Vite at
# build time. In production the same values are provided by the deployment
# platform's environment settings.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENV=local
VITE_I18N_DEFAULT_LOCALE=en
VITE_I18N_SUPPORTED_LOCALES=en,fa
