# ---------------------------------------------------------------------------
# Hanahoush Backend - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Classification:
#   REQUIRED        — must be set in every environment
#   PRODUCTION ONLY — must be set with real values in production
#   OPTIONAL        — safe to leave at default
#   LOCAL ONLY      — dev convenience, ignored/overridden in production
# ---------------------------------------------------------------------------

# Django — REQUIRED
DJANGO_SETTINGS_MODULE=config.settings.local  # LOCAL ONLY value; production uses config.settings.production
DJANGO_SECRET_KEY=change-me-in-production  # PRODUCTION ONLY: long random value, min 50 chars
DJANGO_DEBUG=True  # LOCAL ONLY; production.py forces False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0  # PRODUCTION ONLY: real domain(s), no wildcards
DJANGO_ENVIRONMENT=local  # OPTIONAL (surfaced by /api/health + /api/version)
APP_VERSION=1.0.0  # OPTIONAL (surfaced by /api/version)
SITE_URL=http://localhost:5173  # PRODUCTION ONLY: canonical https URL (sitemap/robots/canonical)
FRONTEND_URL=http://localhost:5173  # PRODUCTION ONLY: used for password-reset links
TIME_ZONE=UTC  # OPTIONAL (keep UTC in production)
LOG_LEVEL=INFO  # OPTIONAL

# PostgreSQL — PRODUCTION ONLY real DATABASE_URL (local may use USE_SQLITE=true)
DATABASE_URL=postgres://hanahoush:hanahoush@localhost:5432/hanahoush
# USE_SQLITE=true  # LOCAL ONLY: uncomment for portable SQLite dev (never in production)

# HTTPS posture — PRODUCTION ONLY (defaults assume TLS-terminating proxy)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# CORS (frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_AUTH_COOKIE=True
JWT_AUTH_COOKIE_SECURE=False

# Authentication & security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_SHORT_SESSION_DAYS=1
FRONTEND_URL=http://localhost:5173
THROTTLE_LOGIN=10/min
THROTTLE_REFRESH=30/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_USER=120/min

# Swagger
SWAGGER_PUBLIC=True

# Email — REQUIRED in production (SMTP), LOCAL ONLY console default
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com

# Bootstrap (first-run superuser — only created if no superuser exists)
BOOTSTRAP_ADMIN_ENABLED=True
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@hanahoush.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# Admin
ADMIN_LIST_PER_PAGE=50

# Gunicorn (production)
GUNICORN_PORT=8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# ERP integration (Phase 9B connector foundation)
# ---------------------------------------------------------------------------
# Master switch. Keep False until a real, verified hanRP/Odoo environment is
# available (see docs/reports/phase-09B-discovery.md). When False the app runs
# with the NullProvider and behaves exactly as before Phase 9B.
ERP_ENABLED=False

# Active provider key: null | odoo_hanrp
ERP_PROVIDER=null

# Auth mechanism the adapter will use once verified: oauth2 | api_key | service_account
ERP_AUTH_TYPE=api_key

# ERP base URL (no trailing slash). Only this configured URL is ever contacted.
ERP_BASE_URL=

# Timeouts (seconds)
ERP_TIMEOUT=30
ERP_CONNECT_TIMEOUT=5
ERP_READ_TIMEOUT=15

# Retry policy (bounded exponential backoff with jitter)
ERP_RETRY_COUNT=3
ERP_RETRY_BACKOFF=1
ERP_RETRY_BACKOFF_CAP=30

# Credentials — NEVER commit real values. Inject from a secret store in any
# real environment. Reserved for Phase 9C (outbound API key) / 9D (webhook).
ERP_API_KEY=
ERP_WEBHOOK_SECRET=
