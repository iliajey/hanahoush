# ---------------------------------------------------------------------------
# Hanahoush Backend - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=UTC
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgres://hanahoush:hanahoush@localhost:5432/hanahoush

# CORS (frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_AUTH_COOKIE=True
JWT_AUTH_COOKIE_SECURE=False

# Authentication & security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_SHORT_SESSION_DAYS=1
FRONTEND_URL=http://localhost:5173
THROTTLE_LOGIN=10/min
THROTTLE_REFRESH=30/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_USER=120/min

# Swagger
SWAGGER_PUBLIC=True

# Email
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@hanahoush.local

# Bootstrap (first-run superuser — only created if no superuser exists)
BOOTSTRAP_ADMIN_ENABLED=True
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@hanahoush.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# Admin
ADMIN_LIST_PER_PAGE=50

# Gunicorn (production)
GUNICORN_PORT=8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# ERP integration (Phase 9B connector foundation)
# ---------------------------------------------------------------------------
# Master switch. Keep False until a real, verified hanRP/Odoo environment is
# available (see docs/reports/phase-09B-discovery.md). When False the app runs
# with the NullProvider and behaves exactly as before Phase 9B.
ERP_ENABLED=False

# Active provider key: null | odoo_hanrp
ERP_PROVIDER=null

# Auth mechanism the adapter will use once verified: oauth2 | api_key | service_account
ERP_AUTH_TYPE=api_key

# ERP base URL (no trailing slash). Only this configured URL is ever contacted.
ERP_BASE_URL=

# Timeouts (seconds)
ERP_TIMEOUT=30
ERP_CONNECT_TIMEOUT=5
ERP_READ_TIMEOUT=15

# Retry policy (bounded exponential backoff with jitter)
ERP_RETRY_COUNT=3
ERP_RETRY_BACKOFF=1
ERP_RETRY_BACKOFF_CAP=30

# Credentials — NEVER commit real values. Inject from a secret store in any
# real environment. Reserved for Phase 9C (outbound API key) / 9D (webhook).
ERP_API_KEY=
ERP_WEBHOOK_SECRET=
